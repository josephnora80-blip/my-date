    box-shadow:0 15px 40px rgba(0,0,0,.20);
}

/* اختيار المدينة */

.location{
    display:flex;
    gap:10px;
    align-items:center;
}

select{
    flex:1;

    padding:14px;

    border-radius:14px;

    border:1px solid rgba(255,255,255,.15);

    background:#102b27;

    color:#fff;

    font-size:15px;

    outline:none;
}

button{
    border:0;

    border-radius:14px;

    padding:14px 17px;

    background:#d6b36a;

    color:#10201c;

    font-weight:bold;

    cursor:pointer;
}

/* التاريخ */

.date{
    text-align:center;
}

.gregorian{
    font-size:18px;
    margin-bottom:7px;
}

.hijri{
    color:#d6b36a;
    font-size:15px;
}

/* الساعة */

.clock{
    text-align:center;

    font-size:43px;

    font-weight:bold;

    letter-spacing:2px;

    margin:5px 0;
}

/* الصلاة القادمة */

.next{
    text-align:center;
}

.next-label{
    color:#b9d1cc;

    font-size:14px;

    margin-bottom:8px;
}

.next-name{
    font-size:28px;

    color:#d6b36a;

    font-weight:bold;
}

.remaining{
    margin-top:8px;

    font-size:17px;
}

/* مواقيت الصلاة */

.prayers{
    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:12px;
}

.prayer{
    padding:18px;

    border-radius:18px;

    background:rgba(255,255,255,.06);

    border:1px solid rgba(255,255,255,.08);

    transition:.2s;
}

.prayer.active{
    background:rgba(214,179,106,.15);

    border-color:#d6b36a;

    transform:translateY(-2px);
}

.prayer-top{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:10px;
}

.prayer-name{
    font-size:16px;
}

.icon{
    font-size:20px;
}

.prayer-time{
    font-size:25px;

    font-weight:bold;

    color:#d6b36a;
}

/* الإعلانات */

.ad-box{
    min-height:90px;

    display:flex;

    align-items:center;

    justify-content:center;

    text-align:center;

    border:1px dashed rgba(214,179,106,.35);

    border-radius:18px;

    background:rgba(255,255,255,.035);

    color:#78938e;

    font-size:12px;

    margin-bottom:17px;
}

.ad-box span{
    opacity:.8;
}

/* المعلومات */

.info{
    color:#aac2bd;

    font-size:13px;

    line-height:1.8;

    text-align:center;
}

.loading{
    text-align:center;

    padding:25px;

    color:#b9d1cc;
}

.error{
    text-align:center;

    color:#ffb4a9;

    line-height:1.8;
}

footer{
    text-align:center;

    color:#718d87;

    font-size:12px;

    padding-top:10px;
}

/* الهاتف */

@media(max-width:500px){

    .container{
        width:94%;

        padding-top:10px;
    }

    h1{
        font-size:27px;
    }

    .clock{
        font-size:36px;
    }

    .prayers{
        grid-template-columns:1fr;
    }

    .location{
        flex-direction:column;
    }

    select,
    button{
        width:100%;
    }
}

</style>
</head>


