<script>


/* أسماء الصلوات */

const prayerNames = {

    Fajr:"الفجر",

    Sunrise:"الشروق",

    Dhuhr:"الظهر",

    Asr:"العصر",

    Maghrib:"المغرب",

    Isha:"العشاء"

};


/* الرموز */

const prayerIcons = {

    Fajr:"🌅",

    Sunrise:"☀️",

    Dhuhr:"🌞",

    Asr:"🌤️",

    Maghrib:"🌇",

    Isha:"🌙"

};


let timings = {};


/* تحويل الوقت */

function formatTime(time){

    if(!time){

        return "--:--";

    }

    return time.substring(0,5);

}


/* الساعة الحالية */

function updateClock(){

    const now = new Date();


    const h =
        String(now.getHours()).padStart(2,"0");


    const m =
        String(now.getMinutes()).padStart(2,"0");


    const s =
        String(now.getSeconds()).padStart(2,"0");


    document.getElementById("clock").textContent =
        `${h}:${m}:${s}`;


    updateNextPrayer();

}


/* تحويل توقيت الصلاة إلى Date */

function getTodayPrayer(name){

    const value = timings[name];


    if(!value){

        return null;

    }


    const parts =
        value.split(":").map(Number);


    const date = new Date();


    date.setHours(
        parts[0],
        parts[1],
        0,
        0
    );


    return date;

}


/* معرفة الصلاة القادمة */

function updateNextPrayer(){

    if(!timings.Fajr){

        return;

    }


    const now = new Date();


    const order = [

        "Fajr",
        "Dhuhr",
        "Asr",
        "Maghrib",
        "Isha"

    ];


    let next = null;

    let nextTime = null;


    for(const name of order){

        const time =
            getTodayPrayer(name);


        if(time && time > now){

            next = name;

            nextTime = time;

            break;

        }

    }


    /* إذا سالات صلاة العشاء، القادمة هي فجر الغد */

    if(!next){

        next = "Fajr";


        nextTime =
            getTodayPrayer("Fajr");


        if(nextTime){

            nextTime.setDate(
                nextTime.getDate()+1
            );

        }

    }


    document.getElementById("nextName").textContent =
        prayerNames[next];


    if(nextTime){

        let difference =
            nextTime - now;


        if(difference < 0){

            difference = 0;

        }


        const hours =
            Math.floor(
                difference / 3600000
            );


        const minutes =
            Math.floor(
                (difference % 3600000) / 60000
            );


        const seconds =
            Math.floor(
                (difference % 60000) / 1000
            );


        document.getElementById("remaining").textContent =

            `متبقي ${hours} ساعة و ${minutes} دقيقة و ${seconds} ثانية`;

    }


    highlightPrayer(next);

}


/* تمييز الصلاة القادمة */

function highlightPrayer(next){

    document
        .querySelectorAll(".prayer")
        .forEach(el => {

            el.classList.remove("active");


            if(el.dataset.name === next){

                el.classList.add("active");

            }

        });

}


/* عرض مواقيت الصلاة */

function displayPrayers(){

    const list =
        document.getElementById("prayerList");


    const order = [

        "Fajr",
        "Sunrise",
        "Dhuhr",
        "Asr",
        "Maghrib",
        "Isha"

    ];


    list.className = "prayers";


    list.innerHTML = "";


    order.forEach(name => {

        const div =
            document.createElement("div");


        div.className = "prayer";


        div.dataset.name = name;


        div.innerHTML = `

            <div class="prayer-top">

                <span class="prayer-name">

                    ${prayerNames[name]}

                </span>


                <span class="icon">

                    ${prayerIcons[name]}

                </span>

            </div>


            <div class="prayer-time">

                ${formatTime(timings[name])}

            </div>

        `;


        list.appendChild(div);

    });

}


/* التاريخ */

function updateDate(data){

    if(
        data &&
        data.date
    ){

        const gregorian =
            data.date.gregorian;


        const hijri =
            data.date.hijri;


        document.getElementById("gregorian").textContent =

            `${gregorian.day} ${gregorian.month.en} ${gregorian.year}`;


        document.getElementById("hijri").textContent =

            `${hijri.day} ${hijri.month.ar} ${hijri.year} هـ`;

    }

}


/* تحميل المواقيت */

async function loadPrayerTimes(){

    const city =
        document.getElementById("city").value;


    const list =
        document.getElementById("prayerList");


    list.className = "loading";


    list.textContent =
        "جاري تحميل مواقيت الصلاة...";


    try{


        const url =

        `https://api.aladhan.com/v1/timingsByCity?city=${encodeURIComponent(city)}&country=Morocco&method=21`;


        const response =
            await fetch(url);


        if(!response.ok){

            throw new Error(
                "Network error"
            );

        }


        const result =
            await response.json();


        if(result.code !== 200){

            throw new Error(
                "API error"
            );

        }


        timings =
            result.data.timings;


        displayPrayers();


        updateDate(
            result.data
        );


        updateNextPrayer();


    }catch(error){


        list.className =
            "error";


        list.innerHTML = `

            ⚠️ تعذر تحميل مواقيت الصلاة.

            <br>

            تأكد من اتصال الهاتف بالإنترنت
            ثم حاول مرة أخرى.

        `;

    }

}


/* تغيير المدينة */

document
    .getElementById("city")
    .addEventListener(
        "change",
        loadPrayerTimes
    );


/* تشغيل الساعة */

updateClock();


setInterval(
    updateClock,
    1000
);


/* تحميل المواقيت */

loadPrayerTimes();

</script>

